<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="auth-container">

    <div class="auth-card">

        <div class="logo">
            🎓
        </div>

        <h1>Create Account</h1>

        <p class="subtitle">
            Sign up for your Student Task Manager
        </p>


        <form action="/signup" method="POST">

            <!-- FIXED: Connected name label to input -->
            <label for="name">Name</label>

            <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter your name"
                required
            >


            <!-- FIXED: Connected email label to input -->
            <label for="email">Email</label>

            <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter your email"
                required
            >


            <!-- FIXED: Connected password label to input -->
            <label for="password">Password</label>

            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                minlength="6"
                required
            >


            <button
                type="submit"
                class="primary-button"
            >
                Sign Up
            </button>

        </form>


        <p class="auth-link">

            Already have an account?

            <a href="/login">
                Login
            </a>

        </p>

    </div>

</div>

</body>

</html>
