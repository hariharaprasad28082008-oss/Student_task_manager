<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Add Task</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="container">

    <div class="form-container">

        <h1>➕ Add New Task</h1>

        <p>
            Create a new task
        </p>


        <form
            action="/add-task"
            method="POST"
        >

            <label>Task Title</label>

            <input
                type="text"
                name="title"
                placeholder="Example: Complete Python assignment"
                required
            >


            <label>Description</label>

            <textarea
                name="description"
                rows="5"
                placeholder="Describe your task..."
            ></textarea>


            <label>Due Date</label>

            <input
                type="date"
                name="due_date"
            >


            <label>Priority</label>

            <select name="priority">

                <option value="Low">
                    Low
                </option>

                <option
                    value="Medium"
                    selected
                >
                    Medium
                </option>

                <option value="High">
                    High
                </option>

            </select>


            <button
                type="submit"
                class="primary-button"
            >
                Add Task
            </button>

        </form>


        <a
            href="/"
            class="back-link"
        >
            ← Back to Dashboard
        </a>

    </div>

</div>

</body>

</html>
 